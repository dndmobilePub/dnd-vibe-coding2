{
  "primitive": {
    "white": { "$value": "#ffffff" }, "navy": { "$value": "#102340" },
    "blue": { "$value": "#124c8c" }, "blueDark": { "$value": "#0c386a" },
    "blueLight": { "$value": "#e8f2ff" }, "slate": { "$value": "#73829b" },
    "line": { "$value": "#dce5ef" }, "canvas": { "$value": "#f6f9fc" },
    "green": { "$value": "#12875b" }, "orange": { "$value": "#c85c13" },
    "orangeLight": { "$value": "#fff3e8" }, "greenLight": { "$value": "#e7f6ef" }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{primitive.blue}" }, "primary-hover": { "$value": "{primitive.blueDark}" },
      "foreground": { "$value": "{primitive.navy}" }, "muted": { "$value": "{primitive.slate}" },
      "border": { "$value": "{primitive.line}" }, "background": { "$value": "{primitive.canvas}" },
      "surface": { "$value": "{primitive.white}" }, "accent": { "$value": "{primitive.blueLight}" },
      "success": { "$value": "{primitive.green}" }, "success-soft": { "$value": "{primitive.greenLight}" },
      "warning": { "$value": "{primitive.orange}" }, "warning-soft": { "$value": "{primitive.orangeLight}" }
    },
    "radius": { "control": { "$value": "6px" }, "panel": { "$value": "8px" } },
    "spacing": { "unit": { "$value": "4px" }, "page": { "$value": "32px" } },
    "font": { "sans": { "$value": "Arial, 'Malgun Gothic', sans-serif" } },
    "text": { "sm": { "$value": "13px" }, "base": { "$value": "14px" }, "lg": { "$value": "18px" }, "2xl": { "$value": "28px" } }
  },
  "component": {
    "button": { "height": { "$value": "40px" }, "background": { "$value": "{semantic.color.primary}" }, "radius": { "$value": "{semantic.radius.control}" } },
    "input": { "height": { "$value": "40px" }, "border": { "$value": "{semantic.color.border}" } },
    "card": { "radius": { "$value": "{semantic.radius.panel}" } }
  }
}
